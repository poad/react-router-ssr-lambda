{
  "name": "remix-ssr-lambda",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present --parallel build",
    "lint": "pnpm -r --if-present --parallel lint",
    "lint-fix": "pnpm -r --if-present --parallel lint-fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.77.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  }
}
